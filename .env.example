# GopherHole 环境变量配置模板

# ======= Server 配置 =======
# 服务端私钥,自动生成
PRIVATE_KEY=
# 服务端公钥，用于检测公私钥是否有误
PUBLIC_KEY=

# 鉴权密钥
TOKEN=

# Server 监听地址 (默认 :8086)
BIND_ADDR=:8086

# 分配的虚拟网段前缀 (默认 10.8.0)
VIRTUAL_SUBNET=10.8.0

# ======= Client 配置 =======
# 服务端公钥
SERVER_PUBLIC_KEY=

# External STUN servers (Client mode only, comma separated)
STUN_SERVERS="stun.miwifi.com:3478,stun.chat.bilibili.com:3478,stun.hitv.com:3478"
# 鉴权密钥
TOKEN=

# 自定义主机名
HOSTNAME=

# 协调中心的连接地址
SERVER=127.0.0.1:8086

# 请求分配固定的虚拟 IP (留空则由 Server 自动分配)
IP=

# NAT 保活心跳间隔（秒），用于维持公网映射不被路由器丢弃 (默认 15)
KEEPALIVE_INTERVAL=15
